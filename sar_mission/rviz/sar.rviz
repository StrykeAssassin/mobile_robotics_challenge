Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 30
    Reference Frame: odom
  - Class: rviz_default_plugins/Map
    Name: Live grid
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sar/grid
    Alpha: 0.6
    Color Scheme: map
  - Class: rviz_default_plugins/Path
    Name: Mission route
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sar/route
    Color: 52; 101; 164
    Line Style: Lines
  - Class: rviz_default_plugins/Path
    Name: Planned path
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sar/path
    Color: 25; 255; 0
    Line Style: Lines
  - Class: rviz_default_plugins/MarkerArray
    Name: Targets
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /sar/target_markers
  - Class: rviz_default_plugins/LaserScan
    Name: Pseudo-scan (car)
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /sar/scan
    Size (m): 0.05
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: rviz_default_plugins/LaserScan
    Name: Lidar (sim)
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Size (m): 0.05
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: false
    Marker Scale: 0.5
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 30
      X: 8.5
      Y: 8.5
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
